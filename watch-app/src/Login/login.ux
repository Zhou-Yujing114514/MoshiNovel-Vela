<template>
  <div class="page">
    <text class="title">{{svcLabel}}登录</text>

    <div class="field">
      <text class="label">账号</text>
      <input class="input" type="text" value="{{username}}" onchange="onUserChange" />
    </div>

    <div class="field">
      <text class="label">密码</text>
      <input class="input" type="password" value="{{password}}" onchange="onPassChange" />
    </div>

    <div class="row">
      <switch checked="{{remember}}" onchange="onRememberChange"></switch>
      <text class="remember-label">记住账号</text>
    </div>

    <input class="login-btn" type="button" value="{{logging ? '登录中…' : '登录'}}" onclick="onLogin" disabled="{{logging}}" />

    <text class="bridge-msg" show="{{bridgeMsg}}">{{bridgeMsg}}</text>
  </div>
</template>

<style>
  .page {
    flex-direction: column;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 30px;
    background-color: #000000;
  }
  .title {
    font-size: 44px;
    color: #ffffff;
    margin-bottom: 24px;
  }
  .field {
    flex-direction: row;
    align-items: center;
    margin-bottom: 18px;
  }
  .label {
    font-size: 30px;
    color: #cccccc;
    width: 100px;
  }
  .input {
    flex: 1;
    height: 72px;
    font-size: 30px;
    color: #ffffff;
    background-color: #1a1a1a;
    border-radius: 10px;
    padding-left: 14px;
  }
  .row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 24px;
  }
  .remember-label {
    font-size: 28px;
    color: #cccccc;
    margin-left: 12px;
  }
  .login-btn {
    height: 84px;
    font-size: 36px;
    color: #ffffff;
    background-color: #33b4ff;
    border-radius: 14px;
  }
  .bridge-msg {
    font-size: 26px;
    color: #ff9c9c;
    margin-top: 20px;
  }
</style>

<script>
  import router from '@system.router';
  import prompt from '@system.prompt';
  import api from '../common/api.js';
  import store from '../common/store.js';

  export default {
    public: {
      svc: ''
    },
    private: {
      svcLabel: '',
      username: '',
      password: '',
      remember: false,
      logging: false,
      bridgeMsg: ''
    },
    onInit() {
      const svc = this.svc || '';
      const conf = api.SERVICES && api.SERVICES[svc];
      this.svcLabel = conf ? (conf.label || '') : '';
      // 不预填任何账号，由用户手动输入
    },
    onUserChange(e) {
      this.username = (e && e.value) || '';
    },
    onPassChange(e) {
      this.password = (e && e.value) || '';
    },
    onRememberChange(e) {
      this.remember = !!(e && e.checked);
    },
    onLogin() {
      if (this.logging) return;
      const u = (this.username || '').trim();
      const p = this.password || '';
      if (!u || !p) {
        prompt.showToast({ message: '请输入账号和密码' });
        return;
      }
      this.logging = true;
      this.bridgeMsg = '';
      const svc = this.svc;
      api.login(svc, u, p).then((res) => {
        this.logging = false;
        if (res && res.ok) {
          // 记住账号
          if (this.remember) {
            store.setAccount(svc, { username: u, password: p });
          } else {
            store.setAccount(svc, null);
          }
          prompt.showToast({ message: '登录成功' });
          router.replace({ uri: 'Shelf', params: { svc: svc } });
        } else {
          const msg = (res && res.message) || '登录失败';
          prompt.showToast({ message: msg });
          if (msg.indexOf('桥接') >= 0) {
            this.bridgeMsg = msg;
          }
        }
      }).catch(() => {
        this.logging = false;
        prompt.showToast({ message: '登录失败，请重试' });
      });
    }
  };
</script>
